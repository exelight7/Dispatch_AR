  {
    "id": "OtherContent::29483CB44D4F33964391ED855A5120F7",
    "index": 18,
    "target": "OtherContent",
    "namespace": "",
    "key": "29483CB44D4F33964391ED855A5120F7",
    "source_hash": 536668568,
    "source_file": "Dispatch/Content/Localization/OtherContent/en/OtherContent.locres",
    "context": [
      "/Game/Shared/Hacking/Blueprints/Users/fx/NS_HackingGrid.NS_HackingGrid:Grid_0.NiagaraScriptSource_0.NiagaraGraph_0.NiagaraScriptVariable_107.Metadata.Description"
    ],
    "speaker": "",
    "category": "Phone / Computer UI",
    "en": "Makes the surface of the sprite face towards a custom vector. Must be used with the SpriteRenderer's CustomFacingVector FacingMode option.",
    "ar": "تجعل سطح الصورة الثنائية الأبعاد يتجه نحو متجه مخصص. يجب استخدامها مع خيار FacingMode المسمى CustomFacingVector في SpriteRenderer.",
    "status": "REVIEWED",
    "notes": ""
  },
  {
    "id": "OtherContent::1F09338F4D35C76074A719BBC6110181",
    "index": 19,
    "target": "OtherContent",
    "namespace": "",
    "key": "1F09338F4D35C76074A719BBC6110181",
    "source_hash": 2410437508,
    "source_file": "Dispatch/Content/Localization/OtherContent/en/OtherContent.locres",
    "context": [
      "/Game/Shared/Hacking/Blueprints/Antivirus/Tail/NS_Tentacle.NS_Tentacle:Empty.NiagaraScriptSource_0.NiagaraGraph_0.NiagaraScriptVariable_9.Metadata.Description"
    ],
    "speaker": "",
    "category": "Phone / Computer UI",
    "en": "Mass is factored into the Solver Calculations (Solve Forces and Solve Rotational Forces) where forces are converted into a final velocity. The more massive a particle, the more force is required to move it. ",
    "ar": "تُحتسب الكتلة في حسابات الحل (حل القوى وحل القوى الدورانية)، حيث تُحوّل القوى إلى سرعة نهائية. وكلما زادت كتلة الجسيم، احتاج إلى قوة أكبر لتحريكه. ",
    "status": "REVIEWED",
    "notes": ""
  },
